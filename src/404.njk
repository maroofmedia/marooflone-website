<section class="section error-page-section">
  <div class="container">
    <div class="error-page-card">
      
      <div class="error-header-block">
        <span class="section-eyebrow">404 &bull; LOST IN TRANSIT</span>
        <h1 class="error-page-title">You are lost.</h1>
        <p class="error-page-subtitle">
          There is nothing here.<br>
          <span class="poetic-highlight">But where there is nothing, there is poetry.</span>
        </p>
      </div>

      
      <div class="error-poetry-card">
        <div id="verse-display" class="error-verse-box">
          <div class="verse-loading">Summoning a verse...</div>
        </div>
      </div>

      
      <div class="error-actions-deck">
        <button type="button" onclick="loadPoetry()" class="hero-btn hero-btn--secondary error-verse-btn">
          <span>Another Verse &nbsp;↻</span>
        </button>
        <a href="/" class="hero-btn hero-btn--primary">
          <span>Return Home &nbsp;&rarr;</span>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  const archive = [
    {
      poet: "Mirza Ghalib",
      urdu: "ہزاروں خواہشیں ایسی کہ ہر خواہش پہ دم نکلے<br>بہت نکلے مرے ارمان لیکن پھر بھی کم نکلے",
      trans: "Thousands of desires, each worth dying for; Many of my wishes were fulfilled, yet I remain unsatisfied."
    },
    {
      poet: "Mirza Ghalib",
      urdu: "بس کہ دشوار ہے ہر کام کا آساں ہونا<br>آدمی کو بھی میسر نہیں انساں ہونا",
      trans: "Just as it is difficult for every task to be easy; It is not given even to a man to be truly human."
    },
    {
      poet: "Mirza Ghalib",
      urdu: "رگوں میں دوڑنے پھرنے کے ہم نہیں قائل<br>جب آنکھ ہی سے نہ ٹپکا تو پھر لہو کیا ہے",
      trans: "I am not convinced by blood merely running through veins; If it does not drip from the eyes, what kind of blood is it?"
    },
    {
      poet: "Mirza Ghalib",
      urdu: "دلِ ناداں تجھے ہوا کیا ہے<br>آخر اس درد کی دوا کیا ہے",
      trans: "O crazy heart, what has happened to you? What is the cure for this pain, after all?"
    },
    {
      poet: "Mirza Ghalib",
      urdu: "قیدِ حیات و بندِ غم اصل میں دونوں ایک ہیں<br>موت سے پہلے آدمی غم سے نجات پائے کیوں",
      trans: "The prison of life and the bondage of grief are essentially the same; Why should one expect freedom before death?"
    },
    {
      poet: "Munir Niazi",
      urdu: "ضروری بات کہنی ہو کوئی وعدہ نبھانا ہو<br>اسے آواز دینی ہو اسے واپس بلانا ہو <br>ہمیشہ دیر کر دیتا ہوں میں",
      trans: "Whether I have to say something vital or fulfill a promise; I always end up being late."
    },
    {
      poet: "Parveen Shakir",
      urdu: "وہ تو خوشبو ہے، ہواؤں میں بکھر جائے گا<br>مسئلہ پھول کا ہے، پھول کدھر جائے گا؟",
      trans: "He is fragrance, he will scatter in the winds. The dilemma belongs to the flower — where will it go?"
    },
    {
      poet: "Parveen Shakir",
      urdu: "کوبہ کو پھیل گئی بات شناسائی کی<br>اس نے خوشبو کی طرح میری پذیرائی کی",
      trans: "The news of our acquaintance spread everywhere; He welcomed me just as fragrance unfolds."
    },
    {
      poet: "Faiz Ahmad Faiz",
      urdu: "دل نا امید تو نہیں ناکام ہی تو ہے<br>لمبی ہے غم کی شام مگر شام ہی تو ہے",
      trans: "The heart is not hopeless, only unsuccessful. The evening of sorrow is long, but it is only an evening."
    },
    {
      poet: "Faiz Ahmad Faiz",
      urdu: "مجھ سے پہلی سی محبت مرے محبوب نہ مانگ<br>میں نے سمجھا تھا کہ تو ہے تو درخشاں ہے حیات",
      trans: "My beloved, do not ask from me that past passion; I once imagined life was luminous only because of you."
    },
    {
      poet: "Jaun Elia",
      urdu: "میں بھی بہت عجیب ہوں اتنا عجیب ہوں کہ بس<br>خود کو تباہ کرلیا اور ملال بھی نہیں",
      trans: "I too am strangely built — so strange that I destroyed myself and carry no regret."
    },
    {
      poet: "Jaun Elia",
      urdu: "شرمندگی ہے ہم کو بہت اپنی زیست پر<br>اب تم سے کیا کہیں کہ ہمیں تم سے کیا ہوا",
      trans: "I am deeply ashamed of how I lived; How can I describe what became of us?"
    },
    {
      poet: "Jaun Elia",
      urdu: "جو گزاری نہ جا سکی ہم سے<br>ہم نے وہ زندگی گزاری ہے",
      trans: "The life that was unlivable to bear; That is the very life I lived."
    },
    {
      poet: "Ahmad Faraz",
      urdu: "اب کے ہم بچھڑے تو شاید کبھی خوابوں میں ملیں<br>جس طرح سوکھے ہوئے پھول کتابوں میں ملیں",
      trans: "If we part now, perhaps we will meet in dreams; Just like dried flowers preserved within old books."
    },
    {
      poet: "Ahmad Faraz",
      urdu: "رنجش ہی سہی دل ہی دکھانے کے لیے آ<br>آ پھر سے مجھے چھوڑ کے جانے کے لیے آ",
      trans: "Even out of grievance, come if only to break my heart; Come, even if to leave once more."
    },
    {
      poet: "Allama Iqbal",
      urdu: "ستاروں سے آگے جہاں اور بھی ہیں<br>ابھی عشق کے امتحان اور بھی ہیں",
      trans: "Beyond the stars lie yet other worlds; There are still more tests of passion to face."
    },
    {
      poet: "Allama Iqbal",
      urdu: "خودی کو کر بلند اتنا کہ ہر تقدیر سے پہلے<br>خدا بندے سے خود پوچھے بتا تیری رضا کیا ہے",
      trans: "Elevate your Self to such heights that before writing destiny, God asks: 'Tell me, what is your will?'"
    },
    {
      poet: "Momin Khan Momin",
      urdu: "وہ جو ہم میں تم میں قرار تھا تمہیں یاد ہو کہ نہ یاد ہو<br>وہی یعنی وعدہ نباہ کا تمہیں یاد ہو کہ نہ یاد ہو",
      trans: "That unspoken promise that existed between us, you may remember or not."
    },
    {
      poet: "Nasir Kazmi",
      urdu: "دل میں ایک لہر سی اٹھی ہے ابھی<br>کوئی تازہ ہوا چلی ہے ابھی",
      trans: "A gentle wave stirred within the heart just now; A fresh breeze began to blow."
    },
    {
      poet: "Bashir Badr",
      urdu: "اجالے اپنی یادوں کے ہمارے ساتھ رہنے دو<br>نہ جانے کس گلی میں زندگی کی شام ہو جائے",
      trans: "Let the radiance of your memories linger with me; Who knows in which lane the evening of life will fall."
    },
    {
      poet: "Majrooh Sultanpuri",
      urdu: "میں اکیلا ہی چلا تھا جانبِ منزل مگر<br>لوگ ساتھ آتے گئے اور کارواں بنتا گیا",
      trans: "I had set out alone toward the destination, but fellow travelers joined, and it became a caravan."
    }
  ];

  function loadPoetry() {
    const display = document.getElementById('verse-display');
    if (!display) return;
    const random = archive[Math.floor(Math.random() * archive.length)];
    
    display.style.opacity = '0';
    display.style.transform = 'translateY(6px)';
    
    setTimeout(() => {
      display.innerHTML = `
        <div class="urdu-line">${random.urdu}</div>
        <div class="trans-line">${random.trans}</div>
        <span class="poet-name">&mdash; ${random.poet}</span>
      `;
      display.style.opacity = '1';
      display.style.transform = 'translateY(0)';
    }, 200);
  }

  document.addEventListener("DOMContentLoaded", loadPoetry);
</script>