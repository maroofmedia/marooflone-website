---
layout: 'base.njk'
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - post
    - posts
    - nav
    - tagList
  addAllPagesToCollections: true
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: "Topic: {{ tag | title }} | Maroof Lone"
  description: "Read all essays and posts about {{ tag | title }} written by Maroof Lone. Deep dives into {{ tag }} and related topics."
  noindex: true
---

<section class="section tag-page-section">
  <div class="container">

    <!-- Tag Archive Header -->
    <header class="tag-archive-header">
      <div class="tag-archive-eyebrow">
        <a href="/blog" class="tag-back-link">&larr; ALL WRITINGS</a>
        <span class="tag-eyebrow-sep">&bull;</span>
        <span class="tag-eyebrow-label">TOPIC</span>
      </div>
      <h1 class="tag-archive-title">#{{ tag }}</h1>
      <p class="tag-archive-meta">
        {{ collections[tag].length }} {% if collections[tag].length == 1 %}essay{% else %}essays{% endif %} exploring this theme
      </p>
    </header>

    <!-- Posts Timeline List -->
    <div class="tag-posts-container">
      <div class="posts-list">
        {% set showTags = false %}
        {% for post in collections[tag] | reverse %}
          {% include 'article-snippet.njk' %}
        {% endfor %}
      </div>
    </div>

  </div>
</section>