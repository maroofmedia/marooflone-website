                  <img src="assets/images/main-images/bfgi_logo.webp" alt="Baba Farid College" loading="lazy" width="44" height="44" />
                </div>
                <div class="exp-meta-block">
                  <div class="exp-title-row">
                    <h3 class="exp-role">B.Tech in Computer Science</h3>
