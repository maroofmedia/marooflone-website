  <section class="section hero-section animate-on-scroll">
    <div class="container hero-container">
      <div class="hero-layout">
        
        <!-- Portrait Frame -->
        <div class="hero-avatar-wrapper">
          <div class="hero-avatar-frame">
            <img src="assets/images/main-images/maroof-hero-new-booth-edited.webp" alt="Maroof Lone" class="hero-avatar-img" fetchpriority="high" width="750" height="667">
            <div class="hero-avatar-badge">
              <span class="pulse-dot"></span>
              <span>Available for work</span>
            </div>
          </div>
        </div>

        <!-- Content & Bio -->
        <div class="hero-content">
          <div class="hero-header-block">
            <div class="hero-location-chip">
              <span class="status-dot"></span>
              <span>Srinagar, Kashmir</span>
            </div>
            <h1 class="hero-title">Hi, I'm Maroof <span class="wave">👋</span></h1>
            <p class="hero-role">Computer Science Engineer, Web Developer &amp; Researcher</p>
          </div>

          <div class="hero-bio-text">
            <p>
              I build fast, accessible web applications and investigate the digital landscape through open-source intelligence (OSINT). Deeply curious about the intersection of code, cybersecurity, and media.
            </p>
            <p>
              My focus is creating software and research that makes the internet more reliable, safe, and transparent. When I'm away from the terminal, I write essays on technology, society, and ideas worth sharing.
            </p>
          </div>

          <div class="hero-action-row">
            <a href="/blog" class="hero-btn hero-btn--primary">Read Blog &rarr;</a>
            <a href="/contact-me" class="hero-btn hero-btn--secondary">Get in Touch</a>
            <div class="hero-quick-socials">
              <a href="https://github.com/maroofmedia" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>
              <a href="https://twitter.com/marooflone13" target="_blank" rel="noopener noreferrer" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="https://linkedin.com/in/marooflone13" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="fa-brands fa-linkedin"></i></a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="section what-i-do-section animate-on-scroll delay-1" id="skills">
