      <div class="skills-section-header">
        <span class="skills-eyebrow">WHAT I DO</span>
        <h2 class="skills-title">I build, research & write.</h2>
        <p class="skills-intro">A blend of full-stack web engineering, digital investigations, and clear editorial communication.</p>
      </div>
      
      <div class="skills-compact-grid">
        <!-- Build Card -->
        <div class="skill-card">
          <div class="skill-card-top">
            <span class="skill-index">01</span>
            <div class="skill-icon"><i class="fa-solid fa-code"></i></div>
          </div>
          <h3 class="skill-name">Build</h3>
          <p class="skill-desc">Engineering fast, responsive websites, web applications, and resilient digital infrastructure with modern web standards.</p>
          <div class="skill-tags">
            <span class="skill-tag">HTML / CSS</span>
            <span class="skill-tag">JavaScript</span>
            <span class="skill-tag">WordPress</span>
            <span class="skill-tag">MySQL</span>
            <span class="skill-tag">AWS</span>
            <span class="skill-tag">UI Design</span>
            <span class="skill-tag">cPanel</span>
          </div>
        </div>

        <!-- Research Card -->
        <div class="skill-card">
          <div class="skill-card-top">
            <span class="skill-index">02</span>
            <div class="skill-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
          </div>
          <h3 class="skill-name">Research</h3>
          <p class="skill-desc">Deep-dive open-source intelligence (OSINT), technical fact-checking, and digital investigations to uncover key signals.</p>
          <div class="skill-tags">
            <span class="skill-tag">OSINT Research</span>
            <span class="skill-tag">Digital Forensics</span>
            <span class="skill-tag">Fact-Checking</span>
            <span class="skill-tag">Technical SEO</span>
          </div>
        </div>

        <!-- Write Card -->
        <div class="skill-card">
          <div class="skill-card-top">
            <span class="skill-index">03</span>
            <div class="skill-icon"><i class="fa-solid fa-feather-pointed"></i></div>
          </div>
          <h3 class="skill-name">Write</h3>
          <p class="skill-desc">Breaking down complex technical concepts, digital culture, and human stories into simple, compelling prose.</p>
          <div class="skill-tags">
            <span class="skill-tag">Technical Writing</span>
            <span class="skill-tag">Content Strategy</span>
            <span class="skill-tag">Copywriting</span>
            <span class="skill-tag">Media Analysis</span>
          </div>
        </div>
      </div>
    </div>
  </section>

