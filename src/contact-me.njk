---
title: Contact Me
layout: base.njk
description: "Get in touch with Maroof Lone for web development, OSINT, media consulting, or collaboration opportunities."
---

<section class="section contact-page-section">
  <div class="container">
    
    <div class="contact-page-header">
      <span class="section-eyebrow">GET IN TOUCH</span>
      <h1 class="contact-page-title">Let's Connect</h1>
      <p class="contact-page-subtitle">
        Have a project in mind, an inquiry about web development, or want to discuss a collaboration? Drop a message below or reach out directly.
      </p>
    </div>

    <div class="contact-grid-layout">
      
      <!-- Left Column: Direct Links & Channels -->
      <div class="contact-channels">
        <div class="contact-channel-card">
          <span class="contact-channel-label">Direct Email</span>
          <!--email_off--><a href="mailto:hello@marooflone.com" class="contact-email-link">
            <i class="fa-regular fa-envelope"></i> hello@marooflone.com
          </a><!--/email_off-->
        </div>

        <div class="contact-channel-card">
          <span class="contact-channel-label">Connect Online</span>
          <div class="contact-social-links">
            <a href="https://twitter.com/marooflone13" target="_blank" rel="noopener noreferrer" class="contact-social-item">
              <i class="fa-brands fa-x-twitter"></i>
              <span>Twitter / X</span>
              <span class="arrow">&rarr;</span>
            </a>
            <a href="https://github.com/maroofmedia" target="_blank" rel="noopener noreferrer" class="contact-social-item">
              <i class="fa-brands fa-github"></i>
              <span>GitHub</span>
              <span class="arrow">&rarr;</span>
            </a>
            <a href="https://www.linkedin.com/in/marooflone13/" target="_blank" rel="noopener noreferrer" class="contact-social-item">
              <i class="fa-brands fa-linkedin"></i>
              <span>LinkedIn</span>
              <span class="arrow">&rarr;</span>
            </a>
            <a href="https://instagram.com/marooflone13" target="_blank" rel="noopener noreferrer" class="contact-social-item">
              <i class="fa-brands fa-instagram"></i>
              <span>Instagram</span>
              <span class="arrow">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="contact-status-box">
          <span class="status-dot"></span>
          <span>Open to select media consulting &amp; web projects.</span>
        </div>
      </div>

      <!-- Right Column: Compact Form -->
      <div class="contact-form-container">
        <form action="https://api.web3forms.com/submit" method="POST" class="contact-editorial-form">
          <input type="hidden" name="access_key" value="696a2b6e-b4c9-47bf-919f-d95bd2548b21">
          <input type="hidden" name="subject" id="hidden-subject" value="New Website Inquiry" />

          <div class="contact-form-row">
            <div class="contact-field">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name">
            </div>
            <div class="contact-field">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="your@email.com">
            </div>
          </div>

          <div class="contact-field">
            <label for="phone">Phone / WhatsApp <span class="optional-tag">(Optional)</span></label>
            <input type="tel" id="phone" name="phone" placeholder="+91 ...">
          </div>

          <div class="contact-field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="4" required placeholder="Tell me about your project or inquiry..."></textarea>
          </div>

          <button type="submit" class="contact-submit-btn">
            <span>Send Message</span>
            <i class="fa-solid fa-paper-plane"></i>
          </button>
        </form>
      </div>

    </div>

  </div>
</section>

<script>
  const nameInput = document.getElementById('name');
  const subjectInput = document.getElementById('hidden-subject');

  if (nameInput && subjectInput) {
    nameInput.addEventListener('input', function() {
      if (this.value.trim() !== '') {
        subjectInput.value = "New Message from " + this.value;
      } else {
        subjectInput.value = "New Website Inquiry";
      }
    });
  }
</script>