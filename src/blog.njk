---
title: Maroof's Blog
description: "My digital workspace for everything I learn and unlearn. A home for the things I notice, the random thoughts I care to keep, and the unfinished drafts worth saving."
layout: 'base.njk'
---

<div class="section blog-page-section">
  <div class="container">
    
    <div class="blog-header"> 
      <span class="section-eyebrow">WRITINGS &bull; ESSAYS &bull; ARCHIVE</span>
      <h1 class="blog-section-title">Maroof's Blog</h1>
      <p class="blog-description">My digital workspace for everything I learn and unlearn. A home for the things I notice, the random thoughts I care to keep, and the unfinished drafts worth saving.</p>
    </div>

    {% set showTags = true %}
    {% set yearGroups = collections.post | reverse | groupByYear %}
    {% for group in yearGroups %}
      <div class="posts-year-group">
        <h2 class="posts-year-heading">{{ group.year }}</h2>
        <div class="posts-list">
          {% for post in group.posts %}
            {% include 'article-snippet.njk' %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}

  </div>
</div>