---
title: Life in Frames - Maroof Lone
description: "A curated visual archive of landscapes, architecture, culture, and quiet everyday moments across Kashmir
and beyond. Captured by Maroof Lone."
layout: 'base.njk'
permalink: /gallery/
---

<div class="section gallery-page-section">
  <div class="container container--gallery">

    <div class="gallery-header">
      <span class="section-eyebrow">PLACES • PEOPLE • PERSPECTIVES</span>
      <h1 class="gallery-section-title">Life in Frames</h1>
      <p class="gallery-description">
        Years from now, these photographs might mean something different than they do today. For now, they are simply a
        record of places, people, days, and experiences gathered over time. A little bit of Kashmir, a little bit of
        everywhere else, and many ordinary moments in between.
      </p>
      <p class="gallery-notice">
        <span>All rights reserved. No photograph may be copied, reproduced, distributed, or used elsewhere without
          explicit permission.</span>
      </p>
    </div>

    <!-- Photography Gallery grouped by year -->
    {% set yearGroups = collections.gallery | reverse | groupByYear %}
    {% set currentPhotoIndex = 0 %}
    {% for group in yearGroups %}
    <section class="gallery-year-group" id="gallery-year-{{ group.year }}" data-year="{{ group.year }}">
      <h2 class="gallery-year-heading">{{ group.year }}</h2>
      {% justifiedGallery group.posts, { globalPhotoIndex: currentPhotoIndex } %}
    </section>
    {% set currentPhotoIndex = currentPhotoIndex + group.posts.length %}
    {% endfor %}

  </div>
</div>

<!-- Google Photos Style Timeline Fast-Scroll Scrubber -->
<aside class="gallery-scrubber" id="galleryScrubber" aria-label="Photo timeline navigation" aria-hidden="true">
  <div class="gallery-scrubber__track" id="scrubberTrack">
    <!-- Active floating indicator bubble -->
    <div class="gallery-scrubber__thumb" id="scrubberThumb">
      <div class="gallery-scrubber__bubble" id="scrubberBubble">2026</div>
      <div class="gallery-scrubber__handle" aria-hidden="true"></div>
    </div>

    <!-- Timeline tick markers -->
    <div class="gallery-scrubber__ticks" id="scrubberTicks">
      {% for group in yearGroups %}
      <div class="gallery-scrubber__tick" data-target-year="{{ group.year }}">
        <span class="gallery-scrubber__tick-label">{{ group.year }}</span>
        <span class="gallery-scrubber__dot"></span>
      </div>
      {% endfor %}
    </div>
  </div>
</aside>

<!-- Fullscreen Responsive Lightbox -->
<div id="galleryLightbox" class="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Photo Viewer" hidden>
  <div class="gallery-lightbox__backdrop" data-action="close" aria-hidden="true"></div>

  <div class="gallery-lightbox__container" id="lightboxContainer">

    <!-- Top Bar: Controls (Zoom & Close) -->
    <header class="gallery-lightbox__topbar">
      <div class="gallery-lightbox__controls">
        <button type="button" class="gallery-lightbox__btn gallery-lightbox__zoom-btn" id="lightboxZoomBtn"
          aria-label="Toggle photo zoom (Press Z or click photo)" title="Zoom in / out">
          <svg class="zoom-icon zoom-icon--in" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="11" y1="8" x2="11" y2="14"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
          <svg class="zoom-icon zoom-icon--out" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </button>

        <button type="button" class="gallery-lightbox__btn gallery-lightbox__close" id="lightboxCloseBtn"
          aria-label="Close photo viewer (Press Escape)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Center Stage: Prev Button, Content (Image + Metadata), Next Button -->
    <div class="gallery-lightbox__stage" id="lightboxStage">
      <button type="button" class="gallery-lightbox__btn gallery-lightbox__nav gallery-lightbox__nav--prev"
        id="lightboxPrevBtn" aria-label="Previous photograph (Press Left arrow)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="gallery-lightbox__content" id="lightboxContent">
        <div class="gallery-lightbox__figure" id="lightboxFigure">
          <img id="lightboxImg" class="gallery-lightbox__img" src="" alt="" draggable="false">

          <!-- AI edit info indicator (bottom left of photo) -->
          <div id="lightboxAiBadge" class="gallery-lightbox__ai-badge" hidden>
            <button type="button" class="gallery-lightbox__ai-btn" id="lightboxAiBtn"
              aria-label="AI assistance information" aria-expanded="false" aria-describedby="lightboxAiPopover"
              title="AI Edit Information">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            </button>
            <div id="lightboxAiPopover" class="gallery-lightbox__ai-popover" role="tooltip" hidden>
              <span>This photograph has been partially or fully edited with AI assistance.</span>
            </div>
          </div>
        </div>

        <div class="gallery-lightbox__bottombar" id="lightboxBottomBar">
          <div class="gallery-lightbox__badges">
            <span id="lightboxLocationBadge" class="gallery-lightbox__badge gallery-lightbox__badge--location">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span id="lightboxLocation"></span>
            </span>
            <span id="lightboxDateBadge" class="gallery-lightbox__badge gallery-lightbox__badge--date">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span id="lightboxDate"></span>
            </span>
          </div>

          <p id="lightboxDescription" class="gallery-lightbox__desc"></p>
        </div>
      </div>

      <button type="button" class="gallery-lightbox__btn gallery-lightbox__nav gallery-lightbox__nav--next"
        id="lightboxNextBtn" aria-label="Next photograph (Press Right arrow)">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

  </div>
</div>

<script>
  (function () {
    'use strict';

    const items = Array.from(document.querySelectorAll('[data-gallery-item]'));
    if (!items.length) return;

    const lightbox = document.getElementById('galleryLightbox');
    const imgEl = document.getElementById('lightboxImg');
    const locationBadge = document.getElementById('lightboxLocationBadge');
    const locationEl = document.getElementById('lightboxLocation');
    const dateBadge = document.getElementById('lightboxDateBadge');
    const dateEl = document.getElementById('lightboxDate');
    const aiBadge = document.getElementById('lightboxAiBadge');
    const aiBtn = document.getElementById('lightboxAiBtn');
    const aiPopover = document.getElementById('lightboxAiPopover');
    const descEl = document.getElementById('lightboxDescription');
    const prevBtn = document.getElementById('lightboxPrevBtn');
    const nextBtn = document.getElementById('lightboxNextBtn');
    const closeBtn = document.getElementById('lightboxCloseBtn');
    const zoomBtn = document.getElementById('lightboxZoomBtn');
    const figureEl = document.getElementById('lightboxFigure');
    const bottomBar = document.getElementById('lightboxBottomBar');
    const contentEl = document.getElementById('lightboxContent');
    const container = document.getElementById('lightboxContainer');

    let currentIndex = 0;
    let isOpen = false;
    let lastActiveElement = null;

    // Zoom & Pan state
    let zoomLevel = 1;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let hasDragged = false;
    let startPointerX = 0;
    let startPointerY = 0;
    let startPanX = 0;
    let startPanY = 0;
    let lastTapTime = 0;
    let initialPinchDist = 0;
    let initialPinchScale = 1;

    // Detect if location and date wrapped onto multiple lines
    function updateBadgeWrap() {
      const badgesContainer = document.querySelector('.gallery-lightbox__badges');
      if (!badgesContainer) return;
      badgesContainer.classList.remove('is-multiline');
      if (!locationBadge.hidden && !dateBadge.hidden) {
        const isWrapped = dateBadge.offsetTop > locationBadge.offsetTop + 4;
        if (isWrapped) {
          badgesContainer.classList.add('is-multiline');
        }
      }
    }

    // Keep panning within image bounds so it stays neatly inside its box
    function clampPan() {
      if (zoomLevel <= 1) {
        panX = 0;
        panY = 0;
        return;
      }
      const maxPanX = Math.max(0, (imgEl.offsetWidth * (zoomLevel - 1)) / 2);
      const maxPanY = Math.max(0, (imgEl.offsetHeight * (zoomLevel - 1)) / 2);

      panX = Math.min(maxPanX, Math.max(-maxPanX, panX));
      panY = Math.min(maxPanY, Math.max(-maxPanY, panY));
    }

    function applyZoom(smooth) {
      if (zoomLevel <= 1) {
        zoomLevel = 1;
        panX = 0;
        panY = 0;
        lightbox.classList.remove('is-zoomed');
        if (figureEl) figureEl.classList.remove('is-zoomed');
        imgEl.style.transform = '';
      } else {
        lightbox.classList.add('is-zoomed');
        if (figureEl) figureEl.classList.add('is-zoomed');
        imgEl.style.transform = 'translate3d(' + panX + 'px, ' + panY + 'px, 0) scale(' + zoomLevel + ')';
      }

      if (smooth) {
        imgEl.style.transition = 'transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease';
      } else {
        imgEl.style.transition = 'none';
      }
    }

    function resetZoom(smooth) {
      zoomLevel = 1;
      panX = 0;
      panY = 0;
      isDragging = false;
      hasDragged = false;
      lightbox.classList.remove('is-zoomed', 'is-dragging');
      if (figureEl) figureEl.classList.remove('is-zoomed');
      applyZoom(smooth);
    }

    function toggleZoom(originX, originY) {
      if (zoomLevel > 1) {
        resetZoom(true);
      } else {
        zoomLevel = 2.5;
        if (typeof originX === 'number' && typeof originY === 'number') {
          const rect = imgEl.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const centerY = rect.top + rect.height / 2;
          panX = (centerX - originX) * (zoomLevel - 1);
          panY = (centerY - originY) * (zoomLevel - 1);
          clampPan();
        } else {
          panX = 0;
          panY = 0;
        }
        applyZoom(true);
      }
    }

    // Sync bottombar width to match the rendered image width
    function syncMetaWidth() {
      if (!bottomBar || !imgEl.naturalWidth) return;
      const unscaledWidth = imgEl.offsetWidth || (imgEl.getBoundingClientRect().width / (zoomLevel || 1));
      if (unscaledWidth > 0) {
        if (window.innerWidth <= 640) {
          const mobileTarget = Math.max(unscaledWidth, Math.min(window.innerWidth - 28, 380));
          bottomBar.style.width = mobileTarget + 'px';
          bottomBar.style.maxWidth = '100%';
        } else {
          bottomBar.style.width = unscaledWidth + 'px';
          bottomBar.style.maxWidth = '100%';
        }
      }
      updateBadgeWrap();
    }

    window.addEventListener('resize', function () {
      if (isOpen) {
        syncMetaWidth();
        if (zoomLevel > 1) {
          clampPan();
          applyZoom(false);
        }
      }
    });

    // Preload helper
    function preloadImage(src) {
      if (!src) return;
      const img = new Image();
      img.src = src;
    }

    function renderPhoto(index) {
      if (index < 0 || index >= items.length) return;
      resetZoom(false);
      currentIndex = index;
      const item = items[currentIndex];
      const cardImg = item.querySelector('.gallery-card__img');
      if (cardImg && cardImg.getAttribute('loading') === 'lazy') {
        cardImg.setAttribute('loading', 'eager');
      }

      const src = item.getAttribute('data-src') || '';
      const alt = item.getAttribute('data-alt') || '';
      const date = item.getAttribute('data-date') || '';
      const location = item.getAttribute('data-location') || '';
      const desc = item.getAttribute('data-desc') || '';
      const isAiEdit = item.getAttribute('data-ai-edit') === 'true';

      // Reset AI popover
      if (aiBadge) {
        if (isAiEdit) {
          aiBadge.hidden = false;
        } else {
          aiBadge.hidden = true;
        }
      }
      if (aiBtn) aiBtn.setAttribute('aria-expanded', 'false');
      if (aiPopover) {
        aiPopover.hidden = true;
        aiPopover.classList.remove('is-visible');
      }

      // Fade transition for image
      imgEl.style.opacity = '0.3';
      imgEl.src = src;
      imgEl.alt = alt;
      imgEl.onload = function () {
        imgEl.style.opacity = '1';
        syncMetaWidth();
      };

      // Location badge
      if (location) {
        locationEl.textContent = location;
        locationBadge.hidden = false;
      } else {
        locationBadge.hidden = true;
      }

      // Date badge
      if (date) {
        dateEl.textContent = date;
        dateBadge.hidden = false;
      } else {
        dateBadge.hidden = true;
      }

      // Description
      if (desc) {
        descEl.textContent = desc;
        descEl.style.display = 'block';
      } else {
        descEl.style.display = 'none';
      }

      updateBadgeWrap();

      // Preload neighbours
      const nextIdx = (currentIndex + 1) % items.length;
      const prevIdx = (currentIndex - 1 + items.length) % items.length;
      preloadImage(items[nextIdx].getAttribute('data-src'));
      preloadImage(items[prevIdx].getAttribute('data-src'));
    }

    function openLightbox(index) {
      lastActiveElement = document.activeElement;
      isOpen = true;
      lightbox.removeAttribute('hidden');
      lightbox.classList.remove('is-closing');

      // Reset inline styles from any previous drag/swipe
      if (contentEl) {
        contentEl.style.transform = '';
        contentEl.style.opacity = '';
        contentEl.style.transition = '';
      }
      const backdropEl = lightbox.querySelector('.gallery-lightbox__backdrop');
      if (backdropEl) backdropEl.style.opacity = '';
      const topbarEl = lightbox.querySelector('.gallery-lightbox__topbar');
      if (topbarEl) topbarEl.style.opacity = '';

      // Force reflow for CSS transition
      void lightbox.offsetWidth;
      lightbox.classList.add('is-active');
      document.body.classList.add('gallery-lightbox-open');

      renderPhoto(index);
      requestAnimationFrame(syncMetaWidth);
      closeBtn.focus();

      // Push history state so hardware/browser Back button closes lightbox instead of leaving page
      if (!window.location.hash || window.location.hash !== '#photo-view') {
        history.pushState({ galleryLightbox: true }, '', '#photo-view');
      }
    }

    function closeLightbox(fromHistory) {
      if (!isOpen) return;
      resetZoom(false);
      isOpen = false;
      lightbox.classList.remove('is-active');
      lightbox.classList.add('is-closing');
      document.body.classList.remove('gallery-lightbox-open');

      // If closed via UI (close button, backdrop, Escape, swipe), revert the history hash
      if (!fromHistory && window.location.hash === '#photo-view') {
        history.back();
      }

      setTimeout(function () {
        if (!isOpen) {
          lightbox.setAttribute('hidden', '');
          lightbox.classList.remove('is-closing');
          imgEl.src = '';
          if (contentEl) {
            contentEl.style.transform = '';
            contentEl.style.opacity = '';
            contentEl.style.transition = '';
          }
          const backdropEl = lightbox.querySelector('.gallery-lightbox__backdrop');
          if (backdropEl) backdropEl.style.opacity = '';
          const topbarEl = lightbox.querySelector('.gallery-lightbox__topbar');
          if (topbarEl) topbarEl.style.opacity = '';
          if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
            lastActiveElement.focus();
          }
        }
      }, 280);
    }

    // Handle mobile/browser Back button to close lightbox
    window.addEventListener('popstate', function () {
      if (isOpen) {
        closeLightbox(true);
      }
    });

    function showNext() {
      renderPhoto((currentIndex + 1) % items.length);
    }

    function showPrev() {
      renderPhoto((currentIndex - 1 + items.length) % items.length);
    }

    // Attach click listeners to cards
    items.forEach(function (item, idx) {
      const btn = item.querySelector('.gallery-card__btn');
      if (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          openLightbox(idx);
        });
      }
    });

    // Control buttons
    closeBtn.addEventListener('click', closeLightbox);
    if (zoomBtn) {
      zoomBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        toggleZoom();
      });
    }

    // AI Edit Info Popover toggle
    if (aiBtn && aiPopover) {
      aiBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        const isExpanded = aiBtn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          aiBtn.setAttribute('aria-expanded', 'false');
          aiPopover.hidden = true;
          aiPopover.classList.remove('is-visible');
        } else {
          aiBtn.setAttribute('aria-expanded', 'true');
          aiPopover.hidden = false;
          aiPopover.classList.add('is-visible');
        }
      });

      // Close popover when clicking or tapping anywhere else
      document.addEventListener('pointerdown', function (e) {
        if (aiBadge && !aiBadge.contains(e.target)) {
          if (aiBtn.getAttribute('aria-expanded') === 'true') {
            aiBtn.setAttribute('aria-expanded', 'false');
            aiPopover.hidden = true;
            aiPopover.classList.remove('is-visible');
          }
        }
      });
    }

    nextBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      showNext();
    });
    prevBtn.addEventListener('click', function (e) {
      e.stopPropagation();
      showPrev();
    });

    // Desktop mouse pan & click-to-zoom
    imgEl.addEventListener('mousedown', function (e) {
      if (e.button !== 0) return;
      isDragging = true;
      hasDragged = false;
      startPointerX = e.clientX;
      startPointerY = e.clientY;
      startPanX = panX;
      startPanY = panY;
      lightbox.classList.add('is-dragging');
      e.preventDefault();
    });

    window.addEventListener('mousemove', function (e) {
      if (!isDragging) return;
      const dx = e.clientX - startPointerX;
      const dy = e.clientY - startPointerY;
      if (Math.abs(dx) > 3 || Math.abs(dy) > 3) {
        hasDragged = true;
      }
      if (zoomLevel > 1) {
        panX = startPanX + dx;
        panY = startPanY + dy;
        clampPan();
        applyZoom(false);
      }
    });

    window.addEventListener('mouseup', function (e) {
      if (!isDragging) return;
      isDragging = false;
      lightbox.classList.remove('is-dragging');
      if (!hasDragged) {
        toggleZoom(e.clientX, e.clientY);
      }
    });

    // Backdrop click
    lightbox.addEventListener('click', function (e) {
      if (e.target.hasAttribute('data-action') && e.target.getAttribute('data-action') === 'close') {
        closeLightbox();
      }
    });

    // Click on stage/container background to close (if not clicking image or buttons)
    const stage = document.getElementById('lightboxStage');
    function handleBackgroundClick(e) {
      if (e.target === stage || e.target === container || e.target === figureEl || e.target === contentEl) {
        if (aiBtn && aiBtn.getAttribute('aria-expanded') === 'true') {
          aiBtn.setAttribute('aria-expanded', 'false');
          if (aiPopover) {
            aiPopover.hidden = true;
            aiPopover.classList.remove('is-visible');
          }
          return;
        }
        closeLightbox();
      }
    }
    if (stage) stage.addEventListener('click', handleBackgroundClick);
    if (container) container.addEventListener('click', handleBackgroundClick);

    // Keyboard navigation
    document.addEventListener('keydown', function (e) {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        if (zoomLevel > 1) {
          resetZoom(true);
        } else {
          closeLightbox();
        }
      } else if (e.key === 'z' || e.key === 'Z') {
        e.preventDefault();
        toggleZoom();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        showNext();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showPrev();
      }
    });

    // Touch, Pinch-to-zoom & Swipe navigation for mobile
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;
    let touchStartTime = 0;
    let isTouchPanning = false;
    let isPullingDown = false;

    lightbox.addEventListener('touchstart', function (e) {
      if (!isOpen) return;

      if (e.touches.length === 2) {
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        initialPinchDist = Math.hypot(dx, dy);
        initialPinchScale = zoomLevel;
        isPullingDown = false;
        return;
      }

      if (e.touches.length === 1) {
        const touch = e.touches[0];
        touchStartX = touch.clientX;
        touchStartY = touch.clientY;
        touchStartTime = Date.now();
        startPanX = panX;
        startPanY = panY;
        isPullingDown = false;

        if (contentEl) {
          contentEl.style.transition = 'none';
        }
        const backdropEl = lightbox.querySelector('.gallery-lightbox__backdrop');
        if (backdropEl) backdropEl.style.transition = 'none';
        const topbarEl = lightbox.querySelector('.gallery-lightbox__topbar');
        if (topbarEl) topbarEl.style.transition = 'none';

        if (zoomLevel > 1 && (e.target === imgEl || e.target.closest('#lightboxFigure'))) {
          isTouchPanning = true;
        } else {
          isTouchPanning = false;
        }
      }
    }, { passive: true });

    lightbox.addEventListener('touchmove', function (e) {
      if (!isOpen) return;

      // Two-finger pinch to zoom
      if (e.touches.length === 2 && initialPinchDist > 0) {
        e.preventDefault();
        const dx = e.touches[0].clientX - e.touches[1].clientX;
        const dy = e.touches[0].clientY - e.touches[1].clientY;
        const currentDist = Math.hypot(dx, dy);
        const scaleFactor = currentDist / initialPinchDist;
        zoomLevel = Math.min(4, Math.max(1, initialPinchScale * scaleFactor));
        clampPan();
        applyZoom(false);
        return;
      }

      // Single finger pan when zoomed
      if (e.touches.length === 1 && isTouchPanning && zoomLevel > 1) {
        e.preventDefault();
        const dx = e.touches[0].clientX - touchStartX;
        const dy = e.touches[0].clientY - touchStartY;
        panX = startPanX + dx;
        panY = startPanY + dy;
        clampPan();
        applyZoom(false);
        return;
      }

      // Interactive pull-down to close when unzoomed
      if (e.touches.length === 1 && zoomLevel === 1) {
        const currentY = e.touches[0].clientY;
        const currentX = e.touches[0].clientX;
        const dy = currentY - touchStartY;
        const dx = currentX - touchStartX;

        // If pulling downward and vertical movement dominates horizontal
        if (dy > 6 && Math.abs(dy) > Math.abs(dx) * 1.1) {
          isPullingDown = true;
          e.preventDefault();

          // Damped drag movement for natural physics
          const dampedY = Math.pow(dy, 0.88) * 1.5;
          const scale = Math.max(0.82, 1 - (dy / 900));
          const backdropOpacity = Math.max(0.2, 1 - (dy / 380));

          if (contentEl) {
            contentEl.style.transform = 'translate3d(0, ' + dampedY.toFixed(1) + 'px, 0) scale(' + scale.toFixed(3) + ')';
          }
          const backdropEl = lightbox.querySelector('.gallery-lightbox__backdrop');
          if (backdropEl) backdropEl.style.opacity = backdropOpacity.toFixed(2);
          const topbarEl = lightbox.querySelector('.gallery-lightbox__topbar');
          if (topbarEl) topbarEl.style.opacity = Math.max(0, 1 - (dy / 180)).toFixed(2);
        } else if (!isPullingDown && Math.abs(dx) > 10) {
          // Horizontal swipe in progress, don't trigger pull down
          isPullingDown = false;
        }
      }
    }, { passive: false });

    lightbox.addEventListener('touchend', function (e) {
      if (!isOpen) return;

      if (e.touches.length === 0) {
        initialPinchDist = 0;
        isTouchPanning = false;

        if (zoomLevel < 1.05) {
          resetZoom(true);
        }
      }

      if (e.changedTouches.length === 0) return;
      touchEndX = e.changedTouches[0].clientX;
      touchEndY = e.changedTouches[0].clientY;

      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;
      const tapDuration = Date.now() - touchStartTime;

      // Handle release of pull-down gesture
      if (isPullingDown && zoomLevel === 1) {
        const backdropEl = lightbox.querySelector('.gallery-lightbox__backdrop');
        const topbarEl = lightbox.querySelector('.gallery-lightbox__topbar');
        const velocityY = diffY / Math.max(tapDuration, 1);

        // Close if pulled down past 65px or flicked downward fast (> 0.45 px/ms)
        if (diffY > 65 || (diffY > 30 && velocityY > 0.45)) {
          // Smooth glide off-screen before fully unmounting
          if (contentEl) {
            contentEl.style.transition = 'transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.22s ease-out';
            contentEl.style.transform = 'translate3d(0, 50vh, 0) scale(0.85)';
            contentEl.style.opacity = '0';
          }
          if (backdropEl) {
            backdropEl.style.transition = 'opacity 0.24s cubic-bezier(0.2, 0.8, 0.2, 1)';
            backdropEl.style.opacity = '0';
          }
          if (topbarEl) {
            topbarEl.style.transition = 'opacity 0.18s ease-out';
            topbarEl.style.opacity = '0';
          }

          setTimeout(function () {
            closeLightbox();
          }, 200);
          isPullingDown = false;
          return;
        } else {
          // Snap back smoothly to center
          if (contentEl) {
            contentEl.style.transition = 'transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease';
            contentEl.style.transform = '';
            contentEl.style.opacity = '';
          }
          if (backdropEl) {
            backdropEl.style.transition = 'opacity 0.24s ease';
            backdropEl.style.opacity = '';
          }
          if (topbarEl) {
            topbarEl.style.transition = 'opacity 0.2s ease';
            topbarEl.style.opacity = '';
          }
          isPullingDown = false;
          return;
        }
      }

      // Double tap to toggle zoom on image
      if (e.target === imgEl && Math.abs(diffX) < 15 && Math.abs(diffY) < 15 && tapDuration < 300) {
        const now = Date.now();
        if (now - lastTapTime < 350) {
          toggleZoom(touchEndX, touchEndY);
          lastTapTime = 0;
          return;
        }
        lastTapTime = now;
      }

      // Swipe navigation ONLY when NOT zoomed
      if (zoomLevel === 1) {
        // Horizontal swipe
        if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            showNext();
          } else {
            showPrev();
          }
        }
        // Fallback swipe down to dismiss
        else if (diffY > 90 && Math.abs(diffY) > Math.abs(diffX) * 1.5) {
          closeLightbox();
        }
      }
    }, { passive: true });

    // Proactive viewport loader: ensures lazy gallery images reliably start loading well before entering viewport
    if ('IntersectionObserver' in window) {
      const lazyObserver = new IntersectionObserver(function (entries, observer) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            const card = entry.target;
            const img = card.querySelector('.gallery-card__img');
            if (img && img.getAttribute('loading') === 'lazy') {
              img.loading = 'eager';
              img.removeAttribute('loading');
            }
            observer.unobserve(card);
          }
        });
      }, {
        rootMargin: '500px 0px 500px 0px'
      });

      document.querySelectorAll('.gallery-card').forEach(function (card) {
        const img = card.querySelector('.gallery-card__img');
        if (img && img.complete && img.naturalWidth > 0) return;
        lazyObserver.observe(card);
      });
    }


    // Protect images against right-click save and drag-to-download on desktop & mobile
    document.addEventListener('contextmenu', function (e) {
      if (e.target.closest('.gallery-card') || e.target.closest('.gallery-lightbox')) {
        e.preventDefault();
      }
    });

    document.addEventListener('dragstart', function (e) {
      if (e.target.matches('.gallery-card__img, .gallery-lightbox__img')) {
        e.preventDefault();
      }
    });

    // ==========================================================================
    // Google Photos Style Fast-Scroll Timeline Scrubber
    // ==========================================================================
    const scrubber = document.getElementById('galleryScrubber');
    const scrubberTrack = document.getElementById('scrubberTrack');
    const scrubberThumb = document.getElementById('scrubberThumb');
    const scrubberBubble = document.getElementById('scrubberBubble');
    const yearSections = Array.from(document.querySelectorAll('.gallery-year-group'));

    if (scrubber && scrubberTrack && scrubberThumb && yearSections.length > 1) {
      let isDraggingScrubber = false;
      let hideScrubberTimeout = null;
      let cachedYearOffsets = [];

      function cacheOffsets() {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        cachedYearOffsets = yearSections.map(function (sec) {
          const rect = sec.getBoundingClientRect();
          const top = rect.top + window.scrollY - 100;
          const year = sec.getAttribute('data-year') || '';
          return {
            el: sec,
            year: year,
            top: Math.max(0, top),
            ratio: docHeight > 0 ? Math.min(1, Math.max(0, top / docHeight)) : 0
          };
        });
      }

      cacheOffsets();
      window.addEventListener('resize', cacheOffsets);

      // Show/hide scrubber smoothly on user scroll
      function showScrubber() {
        if (isOpen) return; // Hide when lightbox is open
        scrubber.classList.add('is-visible');
        clearTimeout(hideScrubberTimeout);
        if (!isDraggingScrubber) {
          hideScrubberTimeout = setTimeout(function () {
            if (!isDraggingScrubber) {
              scrubber.classList.remove('is-visible');
              scrubber.classList.remove('is-active');
            }
          }, 1800);
        }
      }

      // Find current visible year based on scroll position
      function getCurrentYearInfo(scrollY) {
        if (!cachedYearOffsets.length) return { year: '', ratio: 0 };
        const probeY = scrollY + (window.innerHeight * 0.35);
        let active = cachedYearOffsets[0];
        for (let i = 0; i < cachedYearOffsets.length; i++) {
          if (probeY >= cachedYearOffsets[i].top) {
            active = cachedYearOffsets[i];
          } else {
            break;
          }
        }
        return active;
      }

      // Update scrubber thumb position based on scroll ratio
      function updateThumbFromScroll() {
        if (isDraggingScrubber || isOpen) return;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (maxScroll <= 150) {
          scrubber.style.display = 'none';
          return;
        } else {
          scrubber.style.display = '';
        }

        const scrollY = window.scrollY || window.pageYOffset;
        const currentYear = getCurrentYearInfo(scrollY);

        if (scrubberBubble && currentYear.year) {
          scrubberBubble.textContent = currentYear.year;
        }

        const trackHeight = scrubberTrack.clientHeight;
        const scrollProgress = Math.min(1, Math.max(0, scrollY / maxScroll));
        const thumbY = scrollProgress * trackHeight;

        scrubberThumb.style.transform = 'translate3d(0, ' + thumbY.toFixed(1) + 'px, 0)';
      }

      window.addEventListener('scroll', function () {
        if (isOpen) return;
        showScrubber();
        requestAnimationFrame(updateThumbFromScroll);
      }, { passive: true });

      // Interactive Pointer Scrubbing (Mouse & Touch)
      function scrubTo(clientY) {
        const rect = scrubberTrack.getBoundingClientRect();
        const offsetY = Math.min(rect.height, Math.max(0, clientY - rect.top));
        const ratio = rect.height > 0 ? offsetY / rect.height : 0;

        scrubberThumb.style.transform = 'translate3d(0, ' + offsetY.toFixed(1) + 'px, 0)';

        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const targetScrollY = ratio * maxScroll;

        window.scrollTo({
          top: targetScrollY,
          behavior: 'auto'
        });

        const activeYear = getCurrentYearInfo(targetScrollY);
        if (scrubberBubble && activeYear.year) {
          scrubberBubble.textContent = activeYear.year;
        }
      }

      scrubber.addEventListener('pointerdown', function (e) {
        if (e.button !== 0 && e.pointerType === 'mouse') return;
        isDraggingScrubber = true;
        try {
          if (typeof scrubber.setPointerCapture === 'function') {
            scrubber.setPointerCapture(e.pointerId);
          }
        } catch (err) { }
        scrubber.classList.add('is-visible', 'is-active');
        clearTimeout(hideScrubberTimeout);
        scrubTo(e.clientY);
        e.preventDefault();
      });

      scrubber.addEventListener('pointermove', function (e) {
        if (!isDraggingScrubber) return;
        scrubTo(e.clientY);
        e.preventDefault();
      });

      function stopScrubbing(e) {
        if (!isDraggingScrubber) return;
        isDraggingScrubber = false;
        try {
          scrubber.releasePointerCapture(e.pointerId);
        } catch (err) { }
        scrubber.classList.remove('is-active');
        showScrubber();
      }

      scrubber.addEventListener('pointerup', stopScrubbing);
      scrubber.addEventListener('pointercancel', stopScrubbing);

      // Initial update
      requestAnimationFrame(function () {
        cacheOffsets();
        updateThumbFromScroll();
      });
    }

  })();
</script>