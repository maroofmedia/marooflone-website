<!DOCTYPE html>
<html lang="en">
<head>
  <script>
    (function() {
      try {
        var savedTheme = localStorage.getItem('theme');
        var theme = savedTheme === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}

      try {
        var now = new Date();
        var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        var kDate = new Date(utc + (5.5 * 3600000));
        var dec = kDate.getHours() + (kDate.getMinutes() / 60);
        var phase = (dec >= 5 && dec < 8) ? 'dawn' :
                    (dec >= 8 && dec < 16.5) ? 'day' :
                    (dec >= 16.5 && dec < 19.5) ? 'sunset' :
                    (dec >= 19.5 && dec < 22) ? 'dusk' : 'night';
        document.documentElement.setAttribute('data-ambient', phase);
      } catch (e) {}
    })();
  </script>
