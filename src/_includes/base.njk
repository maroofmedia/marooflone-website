  <script>
    // Netlify Identity
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }

    // Header Scroll Behavior
    let lastScroll = 0;
    const header = document.getElementById('mainHeader');
    const threshold = 50;

    window.addEventListener('scroll', () => {
      const currentScroll = window.pageYOffset;
      
      // Only trigger if scrolled more than threshold
      if (Math.abs(currentScroll - lastScroll) < 10) return;

      if (currentScroll > lastScroll && currentScroll > threshold) {
        // Scroll Down
        header.classList.add('hidden');
      } else {
        // Scroll Up
        header.classList.remove('hidden');
      }
      lastScroll = currentScroll;
    });

    // Mobile Menu Toggle
    function toggleMobileMenu() {
      const header = document.getElementById('mainHeader');
      if (header) {
        header.classList.toggle('menu-open');
        document.body.classList.toggle('no-scroll', header.classList.contains('menu-open'));
      }
    }
    window.toggleMobileMenu = toggleMobileMenu;
    window.toggleMenu = toggleMobileMenu;

    // Close menu when clicking outside header
    document.addEventListener('click', (e) => {
      const header = document.getElementById('mainHeader');
      if (header && header.classList.contains('menu-open') && !header.contains(e.target)) {
        header.classList.remove('menu-open');
        document.body.classList.remove('no-scroll');
      }
    });

    // Close menu when clicking any navigation link
    document.querySelectorAll('.mobile-nav-link, .nav-link').forEach(link => {
      link.addEventListener('click', () => {
        const header = document.getElementById('mainHeader');
        if (header && header.classList.contains('menu-open')) {
          header.classList.remove('menu-open');
          document.body.classList.remove('no-scroll');
        }
      });
    });

    // Theme Management (Dark Mode Default + Manual Toggle)
    (function() {
      function getPreferredTheme() {
        const savedTheme = localStorage.getItem('theme');
        return savedTheme === 'light' ? 'light' : 'dark';
      }

      function updateThemeUI(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        const btn = document.getElementById('themeToggleBtn');
        if (btn) {
          btn.setAttribute('title', theme === 'light' ? 'Switch to Dark Mode' : 'Switch to Light Mode');
          btn.setAttribute('aria-label', theme === 'light' ? 'Switch to Dark Mode' : 'Switch to Light Mode');
        }
      }

      window.toggleTheme = function() {
        const current = document.documentElement.getAttribute('data-theme') || getPreferredTheme();
        const next = current === 'light' ? 'dark' : 'light';
        localStorage.setItem('theme', next);
        updateThemeUI(next);
      };

      // Initial sync on page load
      updateThemeUI(document.documentElement.getAttribute('data-theme') || getPreferredTheme());
    })();

    // Scroll Animations
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animated');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.animate-on-scroll').forEach(el => {
      observer.observe(el);
    });
  </script>

  <script>
  // Find all code blocks
  document.querySelectorAll('pre').forEach((pre) => {
    // 1. Create the button
    const button = document.createElement('button');
    button.className = 'copy-button';
    button.innerHTML = '<i class="far fa-copy"></i>';
    button.ariaLabel = 'Copy code';

    // 2. Add Click Event
    button.addEventListener('click', () => {
      const code = pre.querySelector('code').innerText;
      
      navigator.clipboard.writeText(code).then(() => {
        button.innerHTML = '<i class="fas fa-check"></i>';
        button.classList.add('copied');
        
        setTimeout(() => {
          button.innerHTML = '<i class="far fa-copy"></i>';
          button.classList.remove('copied');
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy:', err);
      });
    });

    pre.appendChild(button);
  });
  </script>

  <script>
    // Only run on pages with /blog/ in the URL
    if (window.location.pathname.includes('/blog/')) {
      const progressBar = document.getElementById('progress-bar');
      
      window.addEventListener('scroll', () => {
        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (scrollTop / scrollHeight) * 100;
        
        if (progressBar) {
          progressBar.style.width = scrolled + "%";
        }
      });
    }
  </script>


  <!-- Dynamic New Delhi Time-of-Day Ambient Glow Controller -->
  <script>
    (function() {
      const PHASES = [
        { id: 'dawn', name: 'Dawn' },
        { id: 'day', name: 'Day' },
        { id: 'sunset', name: 'Sunset' },
        { id: 'dusk', name: 'Dusk' },
        { id: 'night', name: 'Night' }
      ];

      function getNewDelhiTime() {
        const now = new Date();
        const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        return new Date(utc + (5.5 * 3600000));
      }

      function getLivePhase(d) {
        const dec = d.getHours() + (d.getMinutes() / 60);
        if (dec >= 5 && dec < 8) return 'dawn';
        if (dec >= 8 && dec < 16.5) return 'day';
        if (dec >= 16.5 && dec < 19.5) return 'sunset';
        if (dec >= 19.5 && dec < 22) return 'dusk';
        return 'night';
      }

      function formatTime(d) {
        let h = d.getHours();
        const m = String(d.getMinutes()).padStart(2, '0');
        const ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        return h + ':' + m + ' ' + ampm;
      }

      function updateAmbientUI() {
        const d = getNewDelhiTime();
        const phase = getLivePhase(d);

        document.documentElement.setAttribute('data-ambient', phase);

        const timeEl = document.getElementById('ambientLiveTime');
        const pill = document.getElementById('ambientTimePill');

        if (timeEl) {
          timeEl.textContent = formatTime(d);
        }

        const info = PHASES.find(p => p.id === phase);
        const phaseName = info ? info.name : phase;

        if (pill) {
          pill.setAttribute('title', 'New Delhi: ' + formatTime(d) + ' (' + phaseName + ')\nLive Real-time Atmosphere');
        }
      }

      // Initial UI update
      updateAmbientUI();

      // Sync every 15 seconds
      setInterval(updateAmbientUI, 15000);
    })();
  </script>
</body>
