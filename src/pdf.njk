<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="https://www.marooflone.com/pdf/">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700;800&family=Source+Code+Pro:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <style>
    :root {
      --pdf-bg: #ffffff;
      --pdf-text: #1f2937;
      --pdf-heading: #0f172a;
      --pdf-muted: #4b5563;
      --pdf-faint: #6b7280;
      --pdf-accent: #0f766e;
      --pdf-border: #e2e8f0;
      --pdf-tag-bg: #f8fafc;
      --pdf-tag-border: #cbd5e1;
      --font-main: 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'Source Code Pro', monospace, sans-serif;
    }

    @page {
      size: A4 portrait;
      margin: 8mm 10mm;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-main);
      background-color: #f1f5f9;
      color: var(--pdf-text);
      line-height: 1.42;
      font-size: 12px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Top Navigation Bar */
    .pdf-top-nav {
      max-width: 210mm;
      margin: 16px auto 0;
      padding: 0 4px;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--pdf-muted);
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 8px;
    }

    .pdf-top-nav a {
      color: var(--pdf-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .pdf-top-nav a:hover {
      color: var(--pdf-accent);
      text-decoration: underline;
    }

    /* A4 Sheet */
    .pdf-sheet {
      max-width: 210mm;
      margin: 10px auto 40px;
      background: var(--pdf-bg);
      padding: 10mm 12mm;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
      border-radius: 4px;
    }

    /* Header */
    .pdf-header {
      border-bottom: 2px solid var(--pdf-heading);
      padding-bottom: 8px;
      margin-bottom: 10px;
    }

    .pdf-name {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--pdf-heading);
      letter-spacing: -0.025em;
      line-height: 1.05;
      margin-bottom: 2px;
    }

    .pdf-headline {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--pdf-accent);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .pdf-meta-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 8px;
      margin-top: 6px;
      font-size: 0.72rem;
      font-family: var(--font-mono);
      color: var(--pdf-muted);
    }

    .pdf-meta-group {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 8px;
    }

    .pdf-meta-item {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--pdf-muted);
      text-decoration: none;
      white-space: nowrap;
      cursor: default;
    }

    a.pdf-meta-item {
      color: var(--pdf-muted);
      cursor: pointer;
      transition: color 0.2s ease;
    }

    a.pdf-meta-item:hover {
      color: var(--pdf-accent);
      text-decoration: underline;
    }

    .pdf-meta-item svg {
      width: 11px;
      height: 11px;
      fill: currentColor;
      flex-shrink: 0;
    }

    .pdf-meta-sep {
      color: var(--pdf-faint);
      font-size: 0.62rem;
      user-select: none;
    }

    /* Bio / Summary */
    .pdf-bio {
      font-size: 0.8rem;
      color: var(--pdf-text);
      line-height: 1.42;
      margin-bottom: 10px;
      padding: 6px 10px;
      background: var(--pdf-tag-bg);
      border-left: 3px solid var(--pdf-accent);
      border-radius: 0 4px 4px 0;
    }

    .pdf-bio p+p {
      margin-top: 3px;
    }

    /* Section structure */
    .pdf-section {
      margin-bottom: 10px;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .pdf-section-title {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--pdf-heading);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border-bottom: 1px solid var(--pdf-border);
      padding-bottom: 2px;
      margin-bottom: 6px;
    }

    /* Areas of Expertise Grid */
    .pdf-pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .pdf-pillar-card {
      border: 1px solid var(--pdf-border);
      border-radius: 4px;
      padding: 6px 8px;
      background: #ffffff;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .pdf-pillar-head {
      display: flex;
      align-items: baseline;
      gap: 4px;
      margin-bottom: 2px;
    }

    .pdf-pillar-num {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 700;
      color: var(--pdf-accent);
    }

    .pdf-pillar-title {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--pdf-heading);
    }

    .pdf-pillar-desc {
      font-size: 0.72rem;
      color: var(--pdf-muted);
      line-height: 1.32;
      margin-bottom: 5px;
    }

    .pdf-tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
    }

    .pdf-tag {
      font-family: var(--font-mono);
      font-size: 0.58rem;
      font-weight: 600;
      color: var(--pdf-muted);
      background: var(--pdf-tag-bg);
      border: 1px solid var(--pdf-tag-border);
      padding: 1px 4px;
      border-radius: 3px;
      line-height: 1.2;
    }

    /* Work Experience */
    .pdf-entry-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .pdf-entry {
      break-inside: avoid;
      page-break-inside: avoid;
      border-bottom: 1px dashed var(--pdf-border);
      padding-bottom: 6px;
    }

    .pdf-entry:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .pdf-entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1px;
    }

    .pdf-entry-role {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--pdf-heading);
    }

    .pdf-entry-org {
      font-size: 0.74rem;
      font-weight: 500;
      color: var(--pdf-muted);
    }

    .pdf-entry-org a {
      color: inherit;
      text-decoration: none;
    }

    .pdf-entry-org a:hover {
      color: var(--pdf-accent);
      text-decoration: underline;
    }

    .pdf-entry-date {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      color: var(--pdf-accent);
      white-space: nowrap;
    }

    .pdf-entry-desc {
      font-size: 0.74rem;
      color: var(--pdf-text);
      line-height: 1.38;
      margin-bottom: 4px;
    }

    /* Projects Grid */
    .pdf-proj-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }

    .pdf-proj-card {
      border: 1px solid var(--pdf-border);
      border-radius: 4px;
      padding: 6px 8px;
      background: #ffffff;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .pdf-proj-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 2px;
    }

    .pdf-proj-name {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--pdf-heading);
      text-decoration: none;
    }

    .pdf-proj-name:hover {
      color: var(--pdf-accent);
    }

    .pdf-proj-badge {
      font-family: var(--font-mono);
      font-size: 0.58rem;
      font-weight: 600;
      color: var(--pdf-accent);
      background: rgba(15, 118, 110, 0.08);
      border: 1px solid rgba(15, 118, 110, 0.25);
      border-radius: 3px;
      padding: 1px 4px;
    }

    .pdf-proj-desc {
      font-size: 0.72rem;
      color: var(--pdf-muted);
      line-height: 1.32;
      margin-bottom: 4px;
    }

    .pdf-proj-links {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      color: var(--pdf-faint);
      margin-bottom: 4px;
    }

    .pdf-proj-links a {
      color: var(--pdf-accent);
      text-decoration: none;
    }

    .pdf-proj-links a:hover {
      text-decoration: underline;
    }

    /* Testimonials Grid */
    .pdf-testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .pdf-testimonial-card {
      border: 1px solid var(--pdf-border);
      border-radius: 4px;
      padding: 6px 8px;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .pdf-testimonial-text {
      font-size: 0.72rem;
      color: var(--pdf-text);
      line-height: 1.35;
      font-style: italic;
      margin-bottom: 6px;
    }

    .pdf-testimonial-meta {
      display: flex;
      flex-direction: column;
      border-top: 1px dashed var(--pdf-border);
      padding-top: 4px;
    }

    .pdf-testimonial-author {
      font-weight: 700;
      color: var(--pdf-heading);
      font-size: 0.72rem;
    }

    .pdf-testimonial-role {
      font-size: 0.62rem;
      color: var(--pdf-faint);
    }

    /* Visit My Blog Section */
    .pdf-blog-callout {
      margin-top: 8px;
      padding: 6px 10px;
      background: var(--pdf-tag-bg);
      border: 1px solid var(--pdf-border);
      border-radius: 4px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .pdf-blog-left h3 {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--pdf-heading);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 1px;
    }

    .pdf-blog-left p {
      font-size: 0.72rem;
      color: var(--pdf-muted);
      line-height: 1.3;
      margin: 0;
    }

    .pdf-blog-url {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--pdf-accent);
      text-decoration: none;
      white-space: nowrap;
      padding: 3px 8px;
      background: #ffffff;
      border: 1px solid var(--pdf-tag-border);
      border-radius: 4px;
    }

    .pdf-blog-url:hover {
      text-decoration: underline;
    }

    /* Mobile Screen Responsiveness */
    @media screen and (max-width: 768px) {
      body {
        font-size: 13px;
        line-height: 1.5;
        background-color: #ffffff;
      }

      .pdf-top-nav {
        margin: 12px 18px 0;
        justify-content: center;
        font-size: 0.76rem;
        gap: 12px;
      }

      .pdf-sheet {
        margin: 0;
        padding: 16px 18px 32px;
        box-shadow: none;
        border-radius: 0;
        max-width: 100%;
      }

      .pdf-header {
        padding-bottom: 12px;
        margin-bottom: 12px;
      }

      .pdf-name {
        font-size: 1.6rem;
      }

      .pdf-headline {
        font-size: 0.78rem;
      }

      .pdf-meta-links {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        font-size: 0.72rem;
      }

      .pdf-meta-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 3px 8px;
      }

      .pdf-meta-sep--group {
        display: none;
      }

      .pdf-bio {
        font-size: 0.85rem;
        padding: 8px 12px;
        margin-bottom: 14px;
      }

      .pdf-section {
        margin-bottom: 14px;
      }

      .pdf-section-title {
        font-size: 0.86rem;
        padding-bottom: 3px;
        margin-bottom: 8px;
      }

      .pdf-pillars-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .pdf-pillar-card {
        padding: 8px 10px;
      }

      .pdf-pillar-title {
        font-size: 0.9rem;
      }

      .pdf-pillar-desc {
        font-size: 0.78rem;
      }

      .pdf-tag {
        font-size: 0.65rem;
        padding: 2px 6px;
      }

      .pdf-entry-list {
        gap: 10px;
      }

      .pdf-entry {
        padding-bottom: 8px;
      }

      .pdf-entry-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
        margin-bottom: 4px;
      }

      .pdf-entry-role {
        font-size: 0.88rem;
      }

      .pdf-entry-desc {
        font-size: 0.78rem;
        line-height: 1.45;
      }

      .pdf-proj-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .pdf-proj-card {
        padding: 8px 10px;
      }

      .pdf-proj-name {
        font-size: 0.88rem;
      }

      .pdf-proj-desc {
        font-size: 0.78rem;
      }

      .pdf-testimonials-grid {
        grid-template-columns: 1fr;
        gap: 10px;
      }

      .pdf-testimonial-card {
        padding: 8px 10px;
      }

      .pdf-testimonial-text {
        font-size: 0.78rem;
        line-height: 1.42;
      }

      .pdf-testimonial-author {
        font-size: 0.76rem;
      }

      .pdf-blog-callout {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
      }

      .pdf-blog-left h3 {
        font-size: 0.78rem;
      }

      .pdf-blog-left p {
        font-size: 0.78rem;
      }

      .pdf-blog-url {
        width: 100%;
        text-align: center;
        font-size: 0.8rem;
        padding: 6px 12px;
        box-sizing: border-box;
      }
    }

    /* Print Specific Rules */
    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .pdf-top-nav {
        display: none !important;
      }

      .pdf-sheet {
        box-shadow: none !important;
        border-radius: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        max-width: none !important;
        min-height: auto !important;
      }

      a {
        color: inherit !important;
        text-decoration: none !important;
      }

      a.pdf-meta-item,
      .pdf-blog-url,
      .pdf-proj-links a,
      .pdf-entry-org a,
      .pdf-proj-name {
        color: var(--pdf-accent) !important;
      }
    }
  </style>
</head>

